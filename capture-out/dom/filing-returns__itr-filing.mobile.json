er\", sans-serif","size":"14px","weight":"300","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"ol","depth":12,"box":[20,1258,350,202]},{"tag":"li","depth":13,"box":[20,1258,350,34]},{"tag":"p","depth":14,"box":[38,1258,332,34],"text":"whose income exceeds the applicable exemption limit.","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"300","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"strong","depth":15,"box":[38,1257,69,17],"text":"Individuals","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"400","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"li","depth":13,"box":[20,1292,350,34]},{"tag":"p","depth":14,"box":[38,1292,332,34],"text":"with income from business or profession.","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"300","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"strong","depth":15,"box":[38,1291,218,17],"text":"Business Owners & Professionals","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"400","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"li","depth":13,"box":[20,1325,350,34]},{"tag":"p","depth":14,"box":[38,1325,332,34],"text":"with taxable income or multiple sources of income.","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"300","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"strong","depth":15,"box":[38,1324,126,17],"text":"Salaried Individuals","font":"Inter, \"Inter Placeholder\", sans-serif","size":"14px","weight":"400","lh":"16.8px","ls":"normal","color":"rgb(52, 73, 72)","align":"start","transform":"none"},{"tag":"li","depth":13,"box":[20,1359,350,34]},{"tag":"p","depth":14,"box":[38,1359,332,34],"text":", where fili